{% extends 'base.html.twig' %}

{% block body %}
    <div class="w-75 mx-auto">
        {{ form_start(form) }}
        <div class="col g-0">
            <div class="col-8">
                {{ include('demo/airline/_progress.html.twig') }}
            </div>
            <div class="col-8">
                {% set current_step = form.vars.cursor.currentStep %}
                {% set current_step_block_name = 'flight_' ~ current_step ~ '_step' %}

                <div class="py-4 d-flex flex-column h-100">
                    <div id="flight_step_form" class="flex-grow-1" style="min-height: 410px">
                        <h5 class="card-title">{{ field_label(form[current_step]) }}</h5>
                        <p class="card-text text-muted mb-4">{{ field_help(form[current_step]) }}</p>

                        <hr class="border-secondary-subtle">

                        {% if block(current_step_block_name) is defined %}
                            {{ block(current_step_block_name) }}
                        {% else %}
                            {{ block('flight_default_step') }}
                        {% endif %}
                    </div>
                    <div id="flight_navigator">
                        {{ block('flight_navigator') }}
                    </div>
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block flight_default_step %}
    {{ form_widget(form[current_step]) }}
{% endblock %}

{% block flight_departure_step %}
    <div class="row g-3">
        <div class="col-6">
            {{ form_row(form.departure.fromAirport) }}
        </div>
        <div class="col-6">
            {{ form_row(form.departure.toAirport) }}
        </div>
    </div>
    <div class="row g-3">
        <div class="col-6">
            {{ form_row(form.departure.departureDate) }}
        </div>
        <div class="col-6">
            {{ form_row(form.departure.passengers) }}
        </div>
    </div>
{% endblock %}

{% block flight_passengerDetails_step %}
    <div class="row g-3">
        <div class="col-6">
            {{ form_row(form.passengerDetails.firstName) }}
        </div>
        <div class="col-6">
            {{ form_row(form.passengerDetails.lastName) }}
        </div>
    </div>
    <div class="row g-3">
        <div class="col-6">
            {{ form_row(form.passengerDetails.dateOfBirth) }}
        </div>
    </div>
    <div class="row g-3">
        <div class="col-6">
            {{ form_row(form.passengerDetails.documentType) }}
        </div>
        <div class="col-6">
            {{ form_row(form.passengerDetails.documentNumber) }}
        </div>
    </div>
{% endblock %}

{% block flight_contactInfo_step %}
    <div class="row g-3">
        <div class="col">
            {{ form_row(form.contactInfo.email) }}
        </div>
    </div>
    <div class="row g-3">
        <div class="col">
            {{ form_row(form.contactInfo.phone) }}
        </div>
    </div>
{% endblock %}

{% block flight_confirmation_step %}
    {% set data = form.vars.data %}

    <div class="mb-3">
        <h6 class="fw-bold">Flight Details</h6>
        <div class="row mb-1">
            <div class="col-4 text-muted">Trip Type:</div>
            <div class="col-8">{{ data.tripType == 'round_trip' ? 'Round Trip' : 'One Way' }}</div>
        </div>
        <div class="row mb-1">
            <div class="col-4 text-muted">Route:</div>
            <div class="col-8">{{ data.fromAirport }} &rarr; {{ data.toAirport }}</div>
        </div>
        <div class="row mb-1">
            <div class="col-4 text-muted">Departure:</div>
            <div class="col-8">{{ data.departureDate }}</div>
        </div>
        {% if data.tripType == 'round_trip' and data.returnDate %}
            <div class="row mb-1">
                <div class="col-4 text-muted">Return:</div>
                <div class="col-8">{{ data.returnDate }}</div>
            </div>
        {% endif %}
        <div class="row mb-1">
            <div class="col-4 text-muted">Passengers:</div>
            <div class="col-8">{{ data.passengers }}</div>
        </div>
    </div>

    <hr class="border-secondary-subtle">

    <div class="mb-3">
        <h6 class="fw-bold">Passenger</h6>
        <div class="row mb-1">
            <div class="col-4 text-muted">Name:</div>
            <div class="col-8">{{ data.passengerDetails.firstName }} {{ data.passengerDetails.lastName }}</div>
        </div>
        <div class="row mb-1">
            <div class="col-4 text-muted">Date of Birth:</div>
            <div class="col-8">{{ data.passengerDetails.dateOfBirth }}</div>
        </div>
        <div class="row mb-1">
            <div class="col-4 text-muted">Document:</div>
            <div class="col-8">{{ data.passengerDetails.documentType|replace({'_': ' '})|title }} — {{ data.passengerDetails.documentNumber }}</div>
        </div>
    </div>

    <hr class="border-secondary-subtle">

    <div class="mb-3">
        <h6 class="fw-bold">Extras & Payment</h6>
        <div class="row mb-1">
            <div class="col-4 text-muted">Seat:</div>
            <div class="col-8">{{ data.seatPreference|replace({'_': ' '})|title }}</div>
        </div>
        <div class="row mb-1">
            <div class="col-4 text-muted">Baggage:</div>
            <div class="col-8">{{ data.baggageOption|replace({'_': ' '})|title }}</div>
        </div>
        <div class="row mb-1">
            <div class="col-4 text-muted">Payment:</div>
            <div class="col-8">{{ data.paymentMethod|replace({'_': ' '})|title }}</div>
        </div>
    </div>

    <hr class="border-secondary-subtle">

    {{ form_widget(form.confirmation) }}
{% endblock %}

{% block flight_navigator %}
    <div class="d-flex justify-content-between border-top border-dark border-opacity-10 pt-3 mt-3">
        <div class="d-flex gap-3">
            {% if form.navigator.reset is defined %}
                {{ form_widget(form.navigator.reset, {
                    attr: {class: 'btn-outline-dark'},
                    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer-reset-icon lucide-timer-reset"><path d="M10 2h4"/><path d="M12 14v-4"/><path d="M4 13a8 8 0 0 1 8-7 8 8 0 1 1-5.3 14L4 17.6"/><path d="M9 17H4v5"/></svg>',
                }) }}
            {% endif %}
            {% if form.navigator.back is defined %}
                {{ form_widget(form.navigator.back, {
                    attr: {class: 'btn-outline-dark'},
                    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-move-left"><path d="M6 8L2 12L6 16"/><path d="M2 12H22"/></svg>',
                }) }}
            {% endif %}
        </div>
        <div class="d-flex gap-3">
            {% if form.navigator.next is defined %}
                {{ form_widget(form.navigator.next, {
                    attr: {class: 'btn-dark flex-row-reverse'},
                    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-move-right"><path d="M18 8L22 12L18 16"/><path d="M2 12H22"/></svg>',
                }) }}
            {% endif %}
            {% if form.navigator.finish is defined %}
                {{ form_widget(form.navigator.finish, {
                    attr: {class: 'btn-dark flex-row-reverse'},
                    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>',
                }) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
